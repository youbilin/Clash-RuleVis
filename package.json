{
  "name": "clash-route-desk",
  "private": true,
  "version": "0.3.0",
  "description": "Local-first visual routing workbench for Clash Verge and mihomo.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youbilin/Clash-RuleVis.git"
  },
  "bugs": {
    "url": "https://github.com/youbilin/Clash-RuleVis/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "demo": "npm run build && node scripts/demo.mjs",
    "fixtures:generate": "node --import tsx scripts/export-fixtures.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "node --import tsx --test server/tests/model.test.ts server/tests/importer.test.ts server/tests/generator.test.ts server/tests/rulesets.test.ts server/tests/node-link.test.ts",
    "test:e2e": "npm run build && node tests/e2e/smoke.mjs",
    "rust:test": "cargo test --manifest-path rust/Cargo.toml --workspace",
    "rust:lint": "cd rust && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "desktop:dev": "tauri dev",
    "desktop:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@tanstack/react-virtual": "^3.14.21",
    "@tauri-apps/api": "^2.12.4",
    "diff": "^9.0.0",
    "fastify": "^5.12.7",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tldts": "^7.4.18",
    "undici": "^8.12.3",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
